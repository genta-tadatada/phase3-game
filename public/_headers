# 一時テストデプロイ用。全パスを検索エンジンから除外する。
/*
  X-Robots-Tag: noindex, nofollow, noarchive

# 更新時の白画面/接続拒否対策：
#   index.html はキャッシュさせない（ハッシュ付きJSの最新参照を常に取得）。
#   逆にハッシュ付きassetsは長期キャッシュ可（ファイル名が変わるため上書き不可になっても安全）。
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
