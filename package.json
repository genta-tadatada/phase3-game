{
  "name": "tadatada-soccer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ただタダgames - 高校サッカー監督シミュレーション (Phase3 MVP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "balance": "tsx scripts/simulate-balance.ts",
    "pack": "cmd /c \"if exist dist.zip del dist.zip\" && cmd /c \"C:\\Windows\\System32\\tar.exe -a -c -f dist.zip -C dist .\"",
    "deploy": "npm run build && npm run pack"
  },
  "dependencies": {
    "@svg-maps/japan": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
